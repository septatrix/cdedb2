{% extends "pdf/base.tmpl" %}
{% block title %}{{ ambience['event']['title'] }} – {% trans %}Nametags{% endtrans %}{% endblock %}
{% block style %}
    @page {
        margin: 10mm;
    }
    {# Add an outline to all parts of the nametags for debugging. #}
    {# .nametag > div { outline: 1px dotted red; } #}
    .nametag {
        position: relative;
        float: left;
        width: 87mm;
        height: 53mm;
        margin: 0 1mm 1mm 0;
        border: 0.4pt solid black; {# use "border-color: white" to eliminate the frame #}
        overflow: hidden;
    }
    .nametag > div {
        position: absolute;
    }
    .nametag img {
        width: 100%;
        height: 100%;
    }
    .name {
        top: 5pt;
        left: 5pt;
        width: 55mm;
        height: 27.5mm;
    }
    .name .given-names {
        font-size: 30pt;
        font-weight: bold;
        line-height: 1;
    }
    .name .family-name {
        font-size: 17.28pt;
        font-weight: bold;
    }
    .course {
        top: 32.5mm;
        left: 22.5mm;
        width: 60mm;
        height: 10mm;
    }
    .lodgement {
        top: 42.5mm;
        left: 22.5mm;
        width: 50mm;
        height: 5mm;
    }
    .course-logo {
        top: 5pt;
        left: 60mm;
        width: 25mm;
        height: 25mm;
    }
    .event-logo {
        top: 32.5mm;
        left: 5pt;
        width: 17.5mm;
        height: 17.5mm;
    }
    .minor-pictogram {
        top: 42.5mm;
        left: 77.5mm;
        width: 7.5mm;
        height: 7.5mm;
    }
{% endblock %}
{% block content %}
    {% for part in ambience['event'].parts.values() %}
        <section class="page">
            {{ part.title }}
            <ul>
                {% for age_class, registrations in registrations_by_part_by_age[part.id].items() if registrations %}
                    <li>{{ gettext(age_class|string) }}: {{ ((registrations|length - 1) // 8) + 1 }} {% trans %}pages{% endtrans %}</li>
                {% else %}
                    <li>{{ gettext("No Participants") }}</li>
                {% endfor %}
            </ul>
        </section>
        {% for age_class, registrations in registrations_by_part_by_age[part.id].items() if registrations %}
            {% for page in registrations.items()|batch(8) %}
                <section class="page">
                    {% for registration_id, registration in page %}
                        {% if enums['RegistrationPartStati'](registration['parts'][part.id]['status']).is_present() %}
                            {# jinja does not support list comprehension ... #}
                            {% set mycourses = [] %}
                            {% for track_id, track in registration['tracks'].items()
                                    if ambience['event']['tracks'][track_id]['part_id'] == part.id and track['course_id'] %}
                                {% do mycourses.append((track_id, track['course_id'])) %}
                            {% endfor %}
                            {% set persona = personas[registration['persona_id']] %}
                            <!-- {{ registration_id }} / {{ mycourses }} -->
                            <article class="nametag">
                                <div class="name">
                                    <div class="given-names">{{ persona['nickname'] or persona['given_names'] }}</div>
                                    <span class="family-name">
                                        {#- prepend the legal given_names to the family name, in case there is a nickname -#}
                                        {%- if persona['nickname'] -%}
                                            {{ persona|persona_name() }}
                                        {%- else -%}
                                            {{ persona['family_name'] }}
                                        {%- endif -%}
                                    </span>
                                    {% if persona['pronouns'] and persona['pronouns_nametag'] -%}
                                        ({{ persona['pronouns'] }})
                                    {%- endif %}
                                </div>
                                <div class="course">
                                    {%- if mycourses -%}
                                        {%- for track_id, course_id in mycourses -%}
                                            {%- if (course_id == registration['tracks'][track_id]['course_instructor']) -%}
                                                <em>{{ courses[course_id].shortname }}</em>
                                            {%- else -%}
                                                {{ courses[course_id].shortname }}
                                            {%- endif -%}
                                            {%- if not loop.last -%}
                                                <br>
                                            {%- endif -%}
                                        {%- endfor -%}
                                    {%- elif registration['persona_id'] in ambience['event'].orgas -%}
                                        <em>{% trans %}Orga{% endtrans %}</em>
                                    {%- endif -%}
                                </div>
                                <div class="lodgement">
                                    {%- if registration['parts'][part.id]['lodgement_id'] -%}
                                        {{ lodgements[registration['parts'][part.id]['lodgement_id']].title }}
                                    {%- endif -%}
                                </div>
                                <div class="course-logo">
                                    {%- if mycourses|length == 1 -%}
                                        <img src="logo-{{ mycourses[0][1] }}.png" alt="">
                                    {%- elif mycourses|length > 1 -%}
                                        <img src="multicourse-logo.png" alt="">
                                    {%- elif registration['persona_id'] in ambience['event'].orgas -%}
                                        <img src="orga-logo.png" alt="">
                                    {%- endif -%}
                                </div>
                                <div class="event-logo"><img src="aka-logo.png" alt=""></div>
                                <div class="minor-pictogram">
                                    {%- if registration['age'].is_minor() -%}
                                        <img src="minor-pictogram.png" alt="">
                                    {%- endif -%}
                                </div>
                            </article>
                        {% endif %}
                    {% endfor %}
                </section>
            {% endfor %}
        {% endfor %}
    {% endfor %}
{% endblock %}
