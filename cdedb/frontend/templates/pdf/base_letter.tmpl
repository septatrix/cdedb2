{#
    This is the base template to be extended by all templates for PDF
    documents which are letters. The layout follows DIN 5008 (form B), so
    the address fits into the window of a DL envelope.
#}
{% extends "pdf/base.tmpl" %}
{% block style %}
    @page {
        margin: 20mm 20mm 15mm 25mm;
    }
    html {
        hyphens: auto;
    }
    .address-field {
        {# The window starts 45mm from the top of the page. #}
        margin-top: 25mm;
        width: 80mm;
        height: 45mm;
    }
    .backaddress {
        margin-top: 10mm;
        min-height: 1.3em;
        font-size: 7pt;
        text-decoration: underline;
    }
    .recipient {
        margin-top: 3mm;
    }
    h1, h2, h3 {
        font-family: inherit;
    }
    .fold-mark {
        position: absolute;
        left: -20mm;
        width: 3mm;
        border-top: 0.4pt solid black;
    }
    .date {
        margin-top: 8mm;
        text-align: right;
    }
    .subject {
        margin: 4mm 0 0;
        font-size: 1em;
        font-weight: bold;
    }
    {% block letter_style %}{% endblock %}
{% endblock %}
{% block content %}
    {# Fold marks for a DL envelope and a punch mark, relative to the page area. #}
    <div class="fold-mark" style="top: 85mm"></div>
    <div class="fold-mark" style="top: 128.5mm; width: 5mm"></div>
    <div class="fold-mark" style="top: 190mm"></div>
    <div class="address-field">
        <div class="backaddress">
            {%- block backaddress -%}
                CdE e.&#x202F;V., c/o Rechtsanwalt Manger, Goseriede 13, 30159 Hannover
            {%- endblock -%}
        </div>
        <div class="recipient">{% block recipient %}{% endblock %}</div>
    </div>
    <div class="date">{% block date %}{{ now()|date(lang=lang, verbosity="long") }}{% endblock %}</div>
    <h1 class="subject">{% block subject %}{% endblock %}</h1>
    {% block letter %}{% endblock %}
{% endblock %}
